# Node environment
NODE_ENV=development

# Process timezone — required so "today" boundaries (expense summaries, the
# daily digest) line up with the digest's Asia/Singapore 10pm cron schedule.
TZ=Asia/Singapore

# Database
DATABASE_URL=./data/pluto.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_CHAT_ID=your_telegram_chat_id_here

# Google Gemini API
# Required — Pluto AI classifies every message with Gemini and has no rule-based fallback.
GOOGLE_API_KEY=your_google_api_key_here

# Logging
LOG_LEVEL=info

# Server
PORT=3000

# iOS Shortcut webhook (see docs/ios-shortcut-setup.md)
# Required for POST /api/apple-pay to accept requests — the webhook server
# refuses to start without it, since it's exposed to the internet via a
# Cloudflare Tunnel.
WEBHOOK_API_KEY=your_webhook_shared_secret_here
