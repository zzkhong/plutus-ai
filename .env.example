# Copy to .env for local development. On Vercel, set these in
# Project -> Settings -> Environment Variables instead (see SETUP.md).

# --- Required everywhere -----------------------------------------------------

# Encrypts each user's BYOK LLM API key at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored key undecryptable - users must re-run /setup.
ENCRYPTION_KEY=

# --- Database ----------------------------------------------------------------

# Local development: a SQLite file, created on first run.
# Production (Vercel): your Turso URL, e.g.
#   libsql://plutus-<your-org>.aws-ap-northeast-1.turso.io
DATABASE_URL=file:./data/pluto.db

# Required when DATABASE_URL is a libsql:// Turso URL; leave empty for a file.
DATABASE_AUTH_TOKEN=

# --- Telegram ----------------------------------------------------------------

# Optional: without it the bot doesn't start. Locally, use a SEPARATE
# development bot - the production bot's token is claimed by its webhook.
TELEGRAM_BOT_TOKEN=

# Required whenever TELEGRAM_BOT_TOKEN is set: the chat that bootstraps as
# admin. Message @userinfobot on Telegram to find your chat ID.
ADMIN_CHAT_ID=

# Vercel only. Telegram sends it on every webhook delivery; the /api/telegram
# route rejects requests without it. Letters, digits, _ and - only. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# --- Vercel Cron -------------------------------------------------------------

# Vercel only. Vercel sends "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/*; without it the daily jobs refuse to run. At least 16 characters.
CRON_SECRET=

# --- General -----------------------------------------------------------------

NODE_ENV=development

# "Today", month boundaries and the local schedulers use this zone. Vercel
# won't let you set TZ, so the app sets it from this. If you change it, also
# change the UTC cron schedules in vercel.json.
APP_TIMEZONE=Asia/Singapore

LOG_LEVEL=info

# Port for the standalone process's HTTP server (Apple Pay webhook, health).
# Ignored on Vercel.
PORT=3000
