# Node environment
NODE_ENV=development

# Process timezone — required so "today" boundaries (expense summaries, the
# daily digest) line up with the digest's Asia/Singapore 10pm cron schedule.
TZ=Asia/Singapore

# Database
DATABASE_URL=./data/pluto.db

# Telegram Bot
# Optional: without it the bot does not start, but the webhook server and the
# recurring/digest crons still run.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The chat_id that bootstraps as admin. Required whenever TELEGRAM_BOT_TOKEN is
# set — this chat is auto-approved on its first /setup and is the only one that
# can /approve or /reject anyone else. Message @userinfobot on Telegram to find
# your chat_id.
ADMIN_CHAT_ID=your_telegram_chat_id_here

# Encrypts each user's BYOK LLM API key at rest (AES-256-GCM). Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value makes every stored key undecryptable — users would have
# to re-run /setup.
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=info

# Server — the iOS Shortcut webhook listens here (see docs/setup/ios-shortcut-setup.md).
# There is no global webhook secret: every approved user gets their own key,
# which they retrieve from the bot with /webhookkey.
PORT=3000
